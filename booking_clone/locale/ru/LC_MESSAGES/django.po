#: apps/bookings/apps.py:7
msgid "Bookings"
msgstr "Бронирования"

#: apps/bookings/models.py:11 apps/bookings/serializers.py:9
msgid "check_out must be after check_in"
msgstr "Дата выезда должна быть позже даты заезда"

#: apps/bookings/models.py:12
msgid "This apartment is already booked for the selected dates"
msgstr "Эта квартира уже забронирована на выбранные даты"

#: apps/bookings/models.py:19
msgid "Pending"
msgstr "Ожидает подтверждения"

#: apps/bookings/models.py:20
msgid "Confirmed"
msgstr "Подтверждено"

#: apps/bookings/models.py:21
msgid "Completed"
msgstr "Завершено"

#: apps/bookings/models.py:22
msgid "Cancelled"
msgstr "Отменено"

#: apps/bookings/models.py:28
msgid "tenant"
msgstr "арендатор"

#: apps/bookings/models.py:29
msgid "The user who is making the booking."
msgstr "Пользователь, который создает бронирование."

#: apps/bookings/models.py:35 apps/properties/models.py:107
#: apps/reviews/models.py:19
msgid "apartment"
msgstr "квартира"

#: apps/bookings/models.py:36
msgid "The apartment being booked."
msgstr "Квартира, которую бронируют."

#: apps/bookings/models.py:39
msgid "check-in date"
msgstr "дата заезда"

#: apps/bookings/models.py:41
msgid "The date the tenant plan to move in."
msgstr "Дата, когда арендатор планирует заехать."

#: apps/bookings/models.py:44
msgid "check-out date"
msgstr "дата выезда"

#: apps/bookings/models.py:46
msgid "The date the tenant plan to move out."
msgstr "Дата, когда арендатор планирует выехать."

#: apps/bookings/models.py:49
msgid "status"
msgstr "статус"

#: apps/bookings/models.py:54
msgid "The current lifecycle stage of the booking."
msgstr "Текущий этап жизненного цикла бронирования."

#: apps/bookings/models.py:57
msgid "total price"
msgstr "итоговая стоимость"

#: apps/bookings/models.py:62
msgid "The total cost of the stay, auto-calculated based on nights."
msgstr ""
"Итоговая стоимость проживания, автоматически рассчитанная по количеству "
"ночей."

#: apps/bookings/models.py:65 apps/properties/models.py:100
#: apps/reviews/models.py:40
msgid "created at"
msgstr "создано"

#: apps/bookings/models.py:68
msgid "The date and time when this booking record was created."
msgstr "Дата и время создания записи бронирования."

#: apps/bookings/models.py:72
msgid "booking"
msgstr "бронирование"

#: apps/bookings/models.py:73
msgid "bookings"
msgstr "бронирования"

#: apps/bookings/serializers.py:8
msgid "check_in cannot be in the past"
msgstr "Дата заезда не может быть в прошлом"

#: apps/bookings/serializers.py:10
msgid "status must be either confirmed or cancelled"
msgstr "Статус должен быть confirmed или cancelled"

#: apps/bookings/views.py:28
msgid "Full update not allowed. Use /cancel/ or /update-status/."
msgstr "Полное обновление запрещено. Используйте /cancel/ или /update-status/."

#: apps/bookings/views.py:31
msgid "Partial update not allowed. Use /cancel/ or /update-status/ instead."
msgstr ""
"Частичное обновление запрещено. Используйте /cancel/ или /update-status/."

#: apps/bookings/views.py:33
msgid "Deletion not allowed. Use the /cancel/ action instead."
msgstr "Удаление запрещено. Вместо этого используйте действие /cancel/."

#: apps/bookings/views.py:34
msgid "Booking is already cancelled."
msgstr "Бронирование уже отменено."

#: apps/bookings/views.py:164
#, python-format
msgid "New booking request from %(email)s for \"%(title)s\"."
msgstr "Новая заявка на бронирование от %(email)s для «%(title)s»."

#: apps/bookings/views.py:221
#, python-format
msgid "Booking for \"%(title)s\" has been cancelled by the tenant."
msgstr "Бронирование «%(title)s» отменено арендатором."

#: apps/bookings/views.py:249
#, python-format
msgid "Your booking for \"%(title)s\" is now %(status)s."
msgstr "Ваше бронирование «%(title)s» теперь имеет статус %(status)s."

#: apps/notifications/apps.py:8 apps/notifications/models.py:59
msgid "Notifications"
msgstr "Уведомления"

#: apps/notifications/models.py:10
msgid "Booking created"
msgstr "Бронирование создано"

#: apps/notifications/models.py:11
msgid "Booking status changed"
msgstr "Статус бронирования изменен"

#: apps/notifications/models.py:12
msgid "Booking cancelled"
msgstr "Бронирование отменено"

#: apps/notifications/models.py:18
msgid "Recipient"
msgstr "Получатель"

#: apps/notifications/models.py:19
msgid "The user who will receive this notification."
msgstr "Пользователь, который получит это уведомление."

#: apps/notifications/models.py:27
msgid "Booking"
msgstr "Бронирование"

#: apps/notifications/models.py:28
msgid "The booking related to this notification, when applicable."
msgstr "Бронирование, связанное с этим уведомлением, если применимо."

#: apps/notifications/models.py:33
msgid "Event type"
msgstr "Тип события"

#: apps/notifications/models.py:34
msgid "Machine-readable notification event type."
msgstr "Машиночитаемый тип события уведомления."

#: apps/notifications/models.py:37
msgid "Message"
msgstr "Сообщение"

#: apps/notifications/models.py:38
msgid "Human-readable notification message."
msgstr "Понятный пользователю текст уведомления."

#: apps/notifications/models.py:43
msgid "Metadata"
msgstr "Метаданные"

#: apps/notifications/models.py:44
msgid "Structured event payload for clients."
msgstr "Структурированные данные события для клиентов."

#: apps/notifications/models.py:48
msgid "Is read"
msgstr "Прочитано"

#: apps/notifications/models.py:49
msgid "Whether the user has seen this notification."
msgstr "Показывает, видел ли пользователь это уведомление."

#: apps/notifications/models.py:53
msgid "Created at"
msgstr "Создано"

#: apps/notifications/models.py:54
msgid "When the notification was generated."
msgstr "Когда было создано уведомление."

#: apps/notifications/models.py:58
msgid "Notification"
msgstr "Уведомление"

#: apps/notifications/views.py:85
msgid "Connected to notification stream"
msgstr "Подключено к потоку уведомлений"

#: apps/notifications/views.py:108
msgid "Unauthorized"
msgstr "Не авторизован"

#: apps/notifications/views.py:112
msgid "Invalid token"
msgstr "Недействительный токен"

#: apps/properties/apps.py:7
msgid "Properties"
msgstr "Объекты размещения"

#: apps/properties/models.py:11 apps/properties/models.py:30
msgid "name"
msgstr "название"

#: apps/properties/models.py:14
msgid "The unique name of the country."
msgstr "Уникальное название страны."

#: apps/properties/models.py:18 apps/properties/models.py:40
msgid "country"
msgstr "страна"

#: apps/properties/models.py:19
msgid "countries"
msgstr "страны"

#: apps/properties/models.py:32
msgid "The name of the city."
msgstr "Название города."

#: apps/properties/models.py:41
msgid "The country this city belongs to."
msgstr "Страна, к которой относится этот город."

#: apps/properties/models.py:46 apps/properties/models.py:75
msgid "city"
msgstr "город"

#: apps/properties/models.py:47
msgid "cities"
msgstr "города"

#: apps/properties/models.py:58
msgid "title"
msgstr "заголовок"

#: apps/properties/models.py:60
msgid "The title of the apartment listing."
msgstr "Заголовок объявления о квартире."

#: apps/properties/models.py:63
msgid "description"
msgstr "описание"

#: apps/properties/models.py:64
msgid "A detailed description of the apartment."
msgstr "Подробное описание квартиры."

#: apps/properties/models.py:67
msgid "address"
msgstr "адрес"

#: apps/properties/models.py:69
msgid "The physical address of the apartment."
msgstr "Физический адрес квартиры."

#: apps/properties/models.py:76
msgid "The city where the apartment is located."
msgstr "Город, в котором находится квартира."

#: apps/properties/models.py:79
msgid "price per night"
msgstr "цена за ночь"

#: apps/properties/models.py:84
msgid "The cost to rent the apartment for one night."
msgstr "Стоимость аренды квартиры за одну ночь."

#: apps/properties/models.py:87
msgid "rooms"
msgstr "комнаты"

#: apps/properties/models.py:90
msgid "The number of rooms available in the apartment."
msgstr "Количество комнат в квартире."

#: apps/properties/models.py:96
msgid "owner"
msgstr "владелец"

#: apps/properties/models.py:97
msgid "The user who owns this apartment listing."
msgstr "Пользователь, которому принадлежит объявление."

#: apps/properties/models.py:103
msgid "The date and time when the listing was created."
msgstr "Дата и время создания объявления."

#: apps/properties/models.py:108
msgid "apartments"
msgstr "квартиры"

#: apps/reviews/apps.py:7
msgid "Reviews"
msgstr "Отзывы"

#: apps/reviews/models.py:20
msgid "The apartment being reviewed."
msgstr "Квартира, к которой относится отзыв."

#: apps/reviews/models.py:26
msgid "author"
msgstr "автор"

#: apps/reviews/models.py:27
msgid "The user who wrote the review."
msgstr "Пользователь, который написал отзыв."

#: apps/reviews/models.py:30
msgid "rating"
msgstr "оценка"

#: apps/reviews/models.py:33
msgid "The rating given by the user (1-5)."
msgstr "Оценка пользователя от 1 до 5."

#: apps/reviews/models.py:36
msgid "comment"
msgstr "комментарий"

#: apps/reviews/models.py:37
msgid "The textual feedback from the user."
msgstr "Текстовый отзыв пользователя."

#: apps/reviews/models.py:43
msgid "The date and time when the review was created."
msgstr "Дата и время создания отзыва."

#: apps/reviews/models.py:46
msgid "updated at"
msgstr "обновлено"

#: apps/reviews/models.py:48
msgid "The date and time when the review was last updated."
msgstr "Дата и время последнего обновления отзыва."

#: apps/reviews/models.py:52
msgid "review"
msgstr "отзыв"

#: apps/reviews/models.py:53
msgid "reviews"
msgstr "отзывы"

#: apps/reviews/serializers.py:6
msgid "Rating must be between 1 and 5."
msgstr "Оценка должна быть от 1 до 5."

#: apps/reviews/views.py:27
msgid "You cannot review your own apartment."
msgstr "Нельзя оставить отзыв на собственную квартиру."

#: apps/reviews/views.py:28
msgid "You can only review apartments you have stayed in."
msgstr "Можно оставлять отзывы только о квартирах, где вы уже проживали."

#: apps/users/admin.py:20
msgid "Personal info"
msgstr "Личная информация"

#: apps/users/admin.py:21
msgid "Roles"
msgstr "Роли"

#: apps/users/admin.py:22
msgid "Permissions"
msgstr "Права доступа"

#: apps/users/admin.py:25
msgid "Important dates"
msgstr "Важные даты"

#: apps/users/apps.py:8 apps/users/models.py:94
msgid "Users"
msgstr "Пользователи"

#: apps/users/models.py:7
msgid "Users must have an email address"
msgstr "У пользователя должен быть адрес электронной почты"

#: apps/users/models.py:8
msgid "Superuser must have is_staff=True"
msgstr "У суперпользователя должно быть is_staff=True"

#: apps/users/models.py:9
msgid "Superuser must have is_superuser=True"
msgstr "У суперпользователя должно быть is_superuser=True"

#: apps/users/models.py:11
msgid "Landlord"
msgstr "Арендодатель"

#: apps/users/models.py:12
msgid "Renter"
msgstr "Арендатор"

#: apps/users/models.py:52
msgid "Email address"
msgstr "Адрес электронной почты"

#: apps/users/models.py:53
msgid "Unique identifier for the user."
msgstr "Уникальный идентификатор пользователя."

#: apps/users/models.py:57
msgid "First name"
msgstr "Имя"

#: apps/users/models.py:58
msgid "User's given name."
msgstr "Имя пользователя."

#: apps/users/models.py:62
msgid "Last name"
msgstr "Фамилия"

#: apps/users/models.py:63
msgid "User's family name."
msgstr "Фамилия пользователя."

#: apps/users/models.py:68
msgid "Is landlord"
msgstr "Арендодатель"

#: apps/users/models.py:69
msgid "Designates whether the user can list apartments."
msgstr "Определяет, может ли пользователь размещать квартиры."

#: apps/users/models.py:73
msgid "Is renter"
msgstr "Арендатор"

#: apps/users/models.py:74
msgid "Designates whether the user can book apartments."
msgstr "Определяет, может ли пользователь бронировать квартиры."

#: apps/users/models.py:78
msgid "Is active"
msgstr "Активен"

#: apps/users/models.py:79
msgid "Designates whether this user should be treated as active."
msgstr "Определяет, считается ли пользователь активным."

#: apps/users/models.py:83
msgid "Is staff"
msgstr "Сотрудник"

#: apps/users/models.py:84
msgid "Designates whether the user can log into this admin site."
msgstr "Определяет, может ли пользователь входить в административную панель."

#: apps/users/models.py:93
msgid "User"
msgstr "Пользователь"

#: apps/users/serializers.py:9
msgid "You must choose exactly one role: Landlord or Renter."
msgstr "Необходимо выбрать ровно одну роль: арендодатель или арендатор."

#: apps/users/serializers.py:10
msgid "Invalid email or password."
msgstr "Неверный адрес электронной почты или пароль."

#: apps/users/serializers.py:11
msgid "User account is disabled."
msgstr "Учетная запись пользователя отключена."

#: apps/users/serializers.py:12
msgid "Must include 'email' and 'password'."
msgstr "Необходимо указать 'email' и 'password'."

