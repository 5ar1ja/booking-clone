# Django
BOOKING_ENV_ID=dev
BOOKING_SECRET_KEY=your-secret-key-here
BOOKING_DEBUG=True
BOOKING_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BOOKING_ALLOWED_HOSTS=localhost,127.0.0.1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CELERY_DB=1
REDIS_DB=2

# Redis Full URLs (optional, override host/port above)
BOOKING_REDIS_URL=redis://localhost:6379/2
BOOKING_CELERY_BROKER_URL=redis://localhost:6379/1

# Flower monitoring (required when running flower service)
FLOWER_USER=admin
FLOWER_PASSWORD=change_me_in_production
